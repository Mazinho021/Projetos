  "captions": [
    {
      "start": 0.21,
      "end": 2.42,
      "text": "O assalto deu certo."
    },
    {
      "start": 2.42,
      "end": 4.95,
      "text": "Seu parceiro ficou\ncom dez milhões."
    },
    {
      "start": 4.95,
      "end": 7.68,
      "text": "Você ficou com o\nrosto no jornal."
    },
    {
      "start": 8.37,
      "end": 10.3,
      "text": "Na tela, seu nome:"
    },
    {
      "start": 10.3,
      "end": 11.74,
      "text": "Zinho."
    },
    {
      "start": 11.74,
      "end": 13.8,
      "text": "Primeiro suspeito\nidentificado."
    },
    {
      "start": 14.42,
      "end": 15.37,
      "text": "Você baixa o volume"
    },
    {
      "start": 15.37,
      "end": 16.43,
      "text": "e abre a mochila"
    },
    {
      "start": 16.43,
      "end": 17.81,
      "text": "que recebeu na divisão."
    },
    {
      "start": 18.48,
      "end": 19.89,
      "text": "Roupa velha."
    },
    {
      "start": 19.89,
      "end": 20.94,
      "text": "Nenhuma nota."
    },
    {
      "start": 21.47,
      "end": 22.79,
      "text": "Confere os bolsos,"
    },
    {
      "start": 22.79,
      "end": 23.51,
      "text": "revira o fundo,"
    },
    {
      "start": 23.51,
      "end": 24.99,
      "text": "espalha tudo no chão."
    },
    {
      "start": 25.5,
      "end": 26.16,
      "text": "Nada."
    },
    {
      "start": 26.72,
      "end": 27.69,
      "text": "Há vinte minutos,"
    },
    {
      "start": 27.69,
      "end": 29.43,
      "text": "vocês ainda\nestavam juntos."
    },
    {
      "start": 29.43,
      "end": 31.19,
      "text": "Agora, ninguém atende."
    },
    {
      "start": 31.65,
      "end": 33.23,
      "text": "Você manda uma foto\nda mochila"
    },
    {
      "start": 33.23,
      "end": 35.05,
      "text": "para o amigo que\ncolocou você no grupo."
    },
    {
      "start": 35.05,
      "end": 37.54,
      "text": "O cara que cresceu\nna sua rua."
    },
    {
      "start": 37.54,
      "end": 38.57,
      "text": "Que prometeu:"
    },
    {
      "start": 38.57,
      "end": 40.07,
      "text": "“Eu garanto a sua parte”.",
      "voice": "amigo"
    },
    {
      "start": 40.55,
      "end": 41.91,
      "text": "Ele visualiza."
    },
    {
      "start": 41.91,
      "end": 42.84,
      "text": "Não responde."
    },
    {
      "start": 43.42,
      "end": 45.27,
      "text": "Você olha de novo\npara a televisão"
    },
    {
      "start": 45.27,
      "end": 47.45,
      "text": "e reconhece a fotografia."
    },
    {
      "start": 47.45,
      "end": 49.09,
      "text": "Foi a mesma\nque enviou a ele"
    },
    {
      "start": 49.09,
      "end": 51.82,
      "text": "quando disseram que\nprecisavam conhecer você."
    },
    {
      "start": 52.3,
      "end": 53.2,
      "text": "Chega um áudio."
    },
    {
      "start": 53.8,
      "end": 55.75,
      "text": "“Eu estava devendo\npara eles.",
      "voice": "amigo"
    },
    {
      "start": 55.75,
      "end": 57.01,
      "text": "Disseram que\na dívida acabava",
      "voice": "amigo"
    },
    {
      "start": 57.01,
      "end": 58.63,
      "text": "se eu colocasse alguém\nno meu lugar.”",
      "voice": "amigo"
    },
    {
      "start": 59.22,
      "end": 60.71,
      "text": "Você escuta outra vez."
    },
    {
      "start": 61.14,
      "end": 62.47,
      "text": "Antes de responder,"
    },
    {
      "start": 62.47,
      "end": 63.8,
      "text": "alguém bate à porta."
    },
    {
      "start": 64.36,
      "end": 66.16,
      "text": "Pela janela,\nvocê vê seu amigo."
    },
    {
      "start": 66.66,
      "end": 68.43,
      "text": "É o homem que\nacabou de admitir"
    },
    {
      "start": 68.43,
      "end": 69.6,
      "text": "que vendeu seu nome."
    },
    {
      "start": 70.05,
      "end": 72.48,
      "text": "Você deixa ele entrar?"
    }
  ]
}